{
  "name": "pharmacy-dw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "连锁药房浏览器端数仓：TypeScript + DuckDB-WASM，ODS/DWD/DWS/ADS 四层、SCD2、迟到回补、数据质量阻断、指标看板",
  "scripts": {
