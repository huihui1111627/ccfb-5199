    "@codemirror/view": "^6.34.1",
    "@duckdb/duckdb-wasm": "^1.29.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "duckdb-async": "^1.4.2",
    "playwright": "^1.65.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
